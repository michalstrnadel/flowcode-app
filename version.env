# version.env — single source of truth for a flowcode release.
#
# Sourced by every release script (build_app.sh, make_venv.sh, sign_notarize.sh)
# and by .github/workflows/release.yml. Keep it POSIX `KEY=value`, no spaces
# around `=`, no shell expansion — it is parsed by both `source` and CI tooling.
#
# Bump VERSION + VOICEMODE_COMMIT together for every release; the git tag that
# triggers CI must match `v${VERSION}` (see release.yml).

# Marketing + bundle version (CFBundleShortVersionString). Must be SemVer.
VERSION=0.2.0

# Monotonic build number (CFBundleVersion). Bump on every uploaded artifact,
# even rebuilds of the same VERSION. Sparkle compares this for "is newer".
BUILD=2

# Pinned voicemode core. make_venv.sh installs EXACTLY this commit from the
# flowcode-overlay fork so the embedded Python is reproducible. Never use a
# moving ref (branch/tag) here — pin the SHA.
VOICEMODE_REPO=https://github.com/mbailey/voicemode.git
VOICEMODE_COMMIT=744ef59ec79ad3a88604b79d1a3916bd2c681888

# Relocatable CPython (python-build-standalone). Pin the release tag + the exact
# python version; make_venv.sh selects the per-arch asset from this tag.
# See: https://github.com/astral-sh/python-build-standalone/releases
PBS_RELEASE=20240814
PYTHON_VERSION=3.12.5

# Bundle identity. Used for codesign identifier prefixes, the Info.plist, the
# notarytool product, and the Sparkle feed. (Changing this changes the codesign
# Designated Requirement → a one-time macOS re-grant of Mic + Accessibility; see
# DISTRIBUTION.md.)
BUNDLE_ID=io.github.michalstrnadel.flowcode
APP_NAME=flowcode

# Sparkle appcast feed URL (where appcast.xml is published). The app's
# SUFeedURL points here; release.yml regenerates appcast.xml against it.
APPCAST_URL=https://github.com/michalstrnadel/flowcode-app/releases/latest/download/appcast.xml
DOWNLOAD_URL_BASE=https://github.com/michalstrnadel/flowcode-app/releases/download
